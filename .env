# Settings for docker-compose.yml. Docker Compose reads this file automatically.

# Port on your computer for the web app (http://localhost:8080)
APP_PORT=8080

# Ports for the optional extras
ADMINER_PORT=8081       # database browser:  docker compose --profile tools up -d
GRAFANA_PORT=3000       # dashboards:        docker compose --profile monitoring up -d
PROMETHEUS_PORT=9090    # metrics:           (same profile)

# Database name and login.
# PostgreSQL only applies these when its volume is first created. If you change them later,
# reset the database with "docker compose down -v" (this deletes all saved history).
# The password is not here: it's a Docker secret in secrets/db_password.txt.
DB_NAME=calculator
DB_USER=calc_user

# The Chaos lab on the Overview page can crash, slow down or break a service on purpose, to show how
# Docker and Kubernetes recover it. Set this to false to switch it off (the services then refuse).
CHAOS_ENABLED=true
